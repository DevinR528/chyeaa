;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="lil_guy"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="uid://clfll0hdyol3m"

[autoload]

PlayerData="*res://src/player_data.gd"
FullscreenToggle="*res://src/presentation/fullscreen_toggle.gd"

[display]

window/size/viewport_width=840
window/size/viewport_height=504
window/size/window_width_override=840
window/size/window_height_override=504
window/stretch/mode="canvas_items"

